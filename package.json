{
  "name": "pdf-poster-maker",
  "version": "1.0.1",
  "description": "Marginless image to PDF converter",
  "productName": "PDF Poster Maker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:all": "rm -rf dist && electron-builder --mac --win --publish never",
    "release": "npm run build:all && gh release create \"v$npm_package_version\" dist/*.zip --target \"$(git rev-parse HEAD)\" --title \"v$npm_package_version\" --generate-notes"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mh-acl.pdf-poster-maker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "!node_modules/pdfjs-dist/**",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/build/pdf.js",
      "node_modules/pdfjs-dist/build/pdf.worker.js",
      "node_modules/pdfjs-dist/cmaps/**",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    }
  }
}
